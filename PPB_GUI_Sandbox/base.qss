/* base.qss – базовые стили для всех виджетов */

* {
    font-family: "Segoe UI", "Roboto", "Helvetica", Arial, sans-serif;
    font-size: 9pt;
}

/* Кнопки – общие */
QPushButton {
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton:focus {
    outline: none;
}

/* Поля ввода */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    border-radius: 4px;
    padding: 4px;
}

/* Чекбоксы и радиокнопки – общая геометрия */
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
}
QCheckBox, QRadioButton {
    spacing: 8px;
}

/* GroupBox */
QGroupBox {
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

/* Вкладки */
QTabBar::tab {
    padding: 6px 12px;
    margin: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabWidget::pane {
    border-radius: 4px;
}

/* Полосы прокрутки */
QScrollBar:vertical {
    width: 12px;
}
QScrollBar::handle:vertical {
    border-radius: 6px;
}

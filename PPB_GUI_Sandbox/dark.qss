/* Тёмная тема – полная */
QWidget {
    background-color: #2b2b2b;
    color: #e0e0e0;
}

/* Кнопки */
QPushButton {
    background-color: #3c3c3c;
    border: 1px solid #5a5a5a;
    border-radius: 6px;
    padding: 6px 12px;
    color: #ffffff;
}
QPushButton:hover {
    background-color: #4a4a4a;
}
QPushButton:pressed {
    background-color: #2a2a2a;
}
QPushButton:checked {
    background-color: #5a5a5a;
}

/* Поля ввода */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #3c3c3c;
    border: 1px solid #5a5a5a;
    color: #ffffff;
}
QComboBox::drop-down {
    border: none;
}

/* Метки (QLabel) */
QLabel {
    color: #e0e0e0;
    background-color: transparent;
}

/* GroupBox */
QGroupBox {
    border: 1px solid #5a5a5a;
    margin-top: 10px;
    color: #e0e0e0;
}
QGroupBox::title {
    background-color: #2b2b2b;
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

/* Вкладки (QTabBar) */
QTabBar::tab {
    background-color: #3c3c3c;
    color: #ffffff;
    padding: 6px 12px;
    margin: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background-color: #5a5a5a;
}
QTabBar::tab:hover:!selected {
    background-color: #4a4a4a;
}
QTabWidget::pane {
    border: 1px solid #5a5a5a;
    background-color: #2b2b2b;
}

/* Чекбоксы и радиокнопки */
QCheckBox, QRadioButton {
    color: #e0e0e0;
}
QCheckBox::indicator, QRadioButton::indicator {
    border: 1px solid #8a8a8a;      /* светлая рамка */
    background-color: #2b2b2b;      /* тёмный фон */
    width: 16px;
    height: 16px;
    border-radius: 3px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #4c9aff;      /* ярко-синий при выборе */
    border: 1px solid #4c9aff;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    background-color: #3a3a3a;
}

/* Полосы прокрутки */
QScrollBar:vertical {
    background: #3c3c3c;
    width: 12px;
}
QScrollBar::handle:vertical {
    background: #5a5a5a;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #6a6a6a;
}

/* Строка состояния */
QStatusBar {
    background-color: #2b2b2b;
    color: #e0e0e0;
}

GrattenControlWidget #botton_onof {
    background-color: #3498db;
    border-radius: 20px;
    padding: 8px 16px;
    color: white;
}
GrattenControlWidget #botton_onof:checked {
    background-color: #e67e22;
}
GrattenControlWidget #botton_onof:hover {
    background-color: #2980b9;
}
GrattenControlWidget #botton_onof:checked:hover {
    background-color: #d35400;
}

/* dark/controll.qss */

/* Чекбоксы внутри контроллера – оранжевые */
ControlWidget QCheckBox::indicator:checked {
    background-color: #f39c12;
    border-color: #f39c12;
}

/* Поля ввода мощности */
ControlWidget QLineEdit {
    background-color: #2d2d2d;
    border: 1px solid #3a3a3a;
    color: #e0e0e0;
}

/* Кнопки опроса, сброса, теста */
ControlWidget QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2d2d2d, stop:1 #1e1e1e);
}
ControlWidget QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3a3a3a, stop:1 #2d2d2d);
}

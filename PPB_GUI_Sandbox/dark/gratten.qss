/* dark/gratten.qss */

/* Кнопка включения/выключения выхода – зелёный/красный */

GrattenControlWidget #botton_onof:!checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4a4a4a, stop:1 #3a3a3a);
    border-color: #5a5a5a;
    color: #e0e0e0;
}
GrattenControlWidget #botton_onof:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #27ae60, stop:1 #2ecc71);
    border-color: #2ecc71;
    color: white;
}

GrattenControlWidget #botton_onof:hover {
    filter: brightness(1.1);
}

/* Лампочка состояния выхода */
GrattenControlWidget #out_label {
    border-radius: 10px;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
}
GrattenControlWidget #out_label[state="on"] {
    background-color: #2ecc71;
}
GrattenControlWidget #out_label[state="off"] {
    background-color: #e74c3c;
}

/* Терминал (поле ввода команд) */
GrattenControlWidget #terminalEdit, GrattenControlWidget #cmdLineEdit {
    background-color: #1e1e1e;
    border: 1px solid #3a3a3a;
    color: #e0e0e0;
    font-family: "Courier New", monospace;
}

/* Остальные кнопки */
GrattenControlWidget QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2d2d2d, stop:1 #1e1e1e);
}

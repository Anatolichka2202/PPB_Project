/* Светлая тема */
QWidget {
    background-color: #f5f5f5;
    color: #2c3e50;
}

QPushButton {
    background-color: #e0e0e0;
    border: 1px solid #bdc3c7;
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton:hover {
    background-color: #d0d0d0;
}
QPushButton:pressed {
    background-color: #c0c0c0;
}
QPushButton:checked {
    background-color: #b0b0b0;
}

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    color: #2c3e50;
}

QLabel {
    color: #2c3e50;
}

QGroupBox {
    border: 1px solid #bdc3c7;
    color: #2c3e50;
}
QGroupBox::title {
    background-color: #f5f5f5;
}

QTabBar::tab {
    background-color: #e0e0e0;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
    border-bottom: none;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #000000;          /* чёрный текст */
    border: 1px solid #bdc3c7;
    border-bottom: none;
}
QTabBar::tab:hover:!selected {
    background-color: #d0d0d0;
}

QCheckBox, QRadioButton {
    color: #2c3e50;
}

/*=========GrattenBtn==================*/
GrattenControlWidget #botton_onof {
    background-color: #3498db;
    border-radius: 20px;
    padding: 8px 16px;
    color: dark;
}
GrattenControlWidget #botton_onof:checked {
    background-color: #e67e22;
}
GrattenControlWidget #botton_onof:hover {
    background-color: #2980b9;
}
GrattenControlWidget #botton_onof:checked:hover {
    background-color: #d35400;
}

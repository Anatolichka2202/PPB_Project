/* light/connection.qss */

/* Кнопка подключения – состояния */
ConnectionWidget #pushButtonConnect[state="idle"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #27ae60, stop:1 #2ecc71);
    border-color: #2ecc71;
    color: white;
}
ConnectionWidget #pushButtonConnect[state="ready"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #34495e, stop:1 #2c3e50);
    border-color: #2c3e50;
    color: white;
}
ConnectionWidget #pushButtonConnect[state="busy"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #95a5a6, stop:1 #7f8c8d);
    border-color: #7f8c8d;
    color: white;
}

/* Кнопка выхода */
ConnectionWidget #pushButtonExit {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e74c3c, stop:1 #c0392b);
    border-color: #c0392b;
    color: white;
}
ConnectionWidget #pushButtonExit:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #c0392b, stop:1 #e74c3c);
}

/* Лампочка состояния бриджа – круглая, меняет цвет */
ConnectionWidget #labelConnectionStatus {
    border-radius: 10px;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
}
ConnectionWidget #labelConnectionStatus[state="on"] {
    background-color: #2ecc71;
}
ConnectionWidget #labelConnectionStatus[state="off"] {
    background-color: #e74c3c;
}

/* light/theme.qss – глобальные стили для светлой темы */

/* Основные цвета */
QWidget {
    background-color: #f4f6f9;
    color: #2c3e50;
}

/* Кнопки – градиент от белого к светло-серому */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #e0e0e0);
    border: 1px solid #bdc3c7;
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0f0f0, stop:1 #d0d0d0);
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #d0d0d0, stop:1 #f0f0f0);
}
QPushButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2980b9, stop:1 #3498db);
    border-color: #2980b9;
    color: white;
}

/* Поля ввода */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 4px;
    color: #2c3e50;
}
QComboBox::drop-down {
    border: none;
}

/* Чекбоксы и радиокнопки – синий акцент */
QCheckBox, QRadioButton {
    color: #2c3e50;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #bdc3c7;
    background-color: #ffffff;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #2980b9;
    border-color: #2980b9;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    background-color: #f0f0f0;
}

/* GroupBox */
QGroupBox {
    border: 1px solid #bdc3c7;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    background-color: #f4f6f9;
}

/* Вкладки */
QTabBar::tab {
    background-color: #e0e0e0;
    color: #2c3e50;
    padding: 6px 12px;
    margin: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border: 1px solid #bdc3c7;
    border-bottom: none;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #000000;
}
QTabBar::tab:hover:!selected {
    background-color: #f0f0f0;
}
QTabWidget::pane {
    border: 1px solid #bdc3c7;
    background-color: #ffffff;
}

/* Полосы прокрутки */
QScrollBar:vertical {
    background: #f0f0f0;
    width: 12px;
}
QScrollBar::handle:vertical {
    background: #c0c0c0;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}

/* Строка состояния */
QStatusBar {
    background-color: #f4f6f9;
    color: #2c3e50;
}
